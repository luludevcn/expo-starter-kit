        "expo-haptics": "~14.0.0",
        "expo-linking": "~7.0.0",
        "expo-notifications": "~0.29.0",
        "expo-router": "~4.0.0",
        "expo-screen-capture": "~7.0.0",
        "expo-secure-store": "~14.0.0",
        "expo-status-bar": "~2.0.0",
        "nativewind": "^4.0.0",
        "react": "18.3.1",
